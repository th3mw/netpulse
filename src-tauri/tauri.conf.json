{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "netpulse",
  "version": "0.1.0",
  "identifier": "com.tauri.netpulse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "NetPulse",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Native desktop vnStat telemetry and network bandwidth monitor suite",
    "longDescription": "NetPulse is a native desktop interface for vnStat with 60-second streaming throughput gauges, 5-minute to yearly telemetry, 7x24 heatmap, and multi-adapter monitoring.",
    "category": "Utility",
    "copyright": "2026 NetPulse",
    "linux": {
      "deb": {
        "depends": ["vnstat"]
      },
      "rpm": {
        "depends": ["vnstat"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
